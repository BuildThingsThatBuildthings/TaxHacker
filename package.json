{
  "name": "taxhacker-cli",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "setup": "prisma migrate deploy --schema src/prisma/schema.prisma && tsx src/cli/setup.ts init",
    "reset": "tsx src/cli/setup.ts reset",
    "db:migrate": "prisma migrate dev --schema src/prisma/schema.prisma",
    "db:generate": "prisma generate --schema src/prisma/schema.prisma",
    "db:studio": "prisma studio --schema src/prisma/schema.prisma"
  },
  "dependencies": {
    "@fast-csv/format": "^5.0.2",
    "@fast-csv/parse": "^5.0.2",
    "@prisma/client": "^6.6.0",
    "jszip": "^3.10.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "prisma": "^6.6.0",
    "tsx": "^4.19.0",
    "typescript": "^5"
  }
}
